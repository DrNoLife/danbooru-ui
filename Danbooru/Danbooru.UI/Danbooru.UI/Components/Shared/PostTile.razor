@using Danbooru.UI.Models
@using System.Globalization

@* One grid cell. Its width grows with the image's aspect ratio, see .jgrid in app.css. *@
<a class="tile" id="post-@Post.Id" href="@Links.Post(Post.Id)" style="--r: @Ratio" aria-label="@Label">
    <img loading="lazy" decoding="async" alt="" src="@Post.PreviewUrl" srcset="@Post.SrcSet" sizes="@Sizes" />
    @if (Post.IsVideo)
    {
        <span class="tile-badge"><Icon Name="play" Size="10" />@Duration</span>
    }
</a>

@code {
    [Parameter, EditorRequired]
    public PostSummary Post { get; set; } = null!;

    /// <summary>
    /// The grid's row height in px, used to tell the browser which variant fits.
    /// </summary>
    [Parameter]
    public int RowHeight { get; set; } = 240;

    // CSS needs a dot as decimal separator whatever the server's culture is.
    private string Ratio => Post.LayoutRatio.ToString("0.###", CultureInfo.InvariantCulture);

    // Rows stretch to fill the width, so ask for a bit more than the base size.
    private string Sizes => $"{Math.Ceiling(Post.LayoutRatio * RowHeight * 1.3)}px";

    private string Duration => Post.Duration is double seconds ? TimeSpan.FromSeconds(seconds).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss") : "Video";

    private string Label
    {
        get
        {
            var tags = Post.TopTags.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(3).Select(x => x.Replace('_', ' '));
            return $"Post {Post.Id}: {String.Join(", ", tags)}";
        }
    }
}
