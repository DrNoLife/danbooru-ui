@* Inline stroke icons, so they follow the text color. Decorative: label the button or link that holds them. *@

<svg class="icon" aria-hidden="true" width="@Size" height="@Size" viewBox="0 0 24 24" fill="@(IsFilled ? "currentColor" : "none")" stroke="@(IsFilled ? "none" : "currentColor")" stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "search":
            <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
            break;
        case "grid":
            <rect x="3" y="4" width="8" height="7" rx="1.5"></rect><rect x="13" y="4" width="8" height="7" rx="1.5"></rect><rect x="3" y="13" width="11" height="7" rx="1.5"></rect><rect x="16" y="13" width="5" height="7" rx="1.5"></rect>
            break;
        case "feed":
            <rect x="6" y="3" width="12" height="13" rx="2"></rect><path d="M8 20h8"></path>
            break;
        case "chevron-down":
            <path d="M6 9l6 6 6-6"></path>
            break;
        case "chevron-up":
            <path d="M6 15l6-6 6 6"></path>
            break;
        case "chevron-left":
            <path d="M15 6l-6 6 6 6"></path>
            break;
        case "chevron-right":
            <path d="M9 6l6 6-6 6"></path>
            break;
        case "more":
            <circle cx="5" cy="12" r="1.8"></circle><circle cx="12" cy="12" r="1.8"></circle><circle cx="19" cy="12" r="1.8"></circle>
            break;
        case "zoom":
            <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5M11 8v6M8 11h6"></path>
            break;
        case "fullscreen":
            <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
            break;
        case "panel":
            <rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M15 4v16"></path>
            break;
        case "download":
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
            break;
        case "external":
            <path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"></path>
            break;
        case "similar":
            <rect x="3" y="7" width="12" height="14" rx="2"></rect><path d="M9 3h10a2 2 0 0 1 2 2v12"></path>
            break;
        case "link":
            <path d="M10 14a4 4 0 0 0 6 0l3-3a4 4 0 0 0-6-6l-1 1M14 10a4 4 0 0 0-6 0l-3 3a4 4 0 0 0 6 6l1-1"></path>
            break;
        case "tag":
            <path d="M3 12V4h8l10 10-8 8z"></path><circle cx="7.5" cy="8.5" r="1.4"></circle>
            break;
        case "share":
            <path d="M12 15V4M8 8l4-4 4 4M5 12v7h14v-7"></path>
            break;
        case "bookmark":
            <path d="M6 3h12v18l-6-4-6 4z"></path>
            break;
        case "clock":
            <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18"></path>
            break;
        case "sort":
            <path d="M4 6h16M7 12h10M10 18h4"></path>
            break;
        case "play":
            <path d="M8 5l11 7-11 7z"></path>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = null!;

    [Parameter]
    public int Size { get; set; } = 18;

    [Parameter]
    public double StrokeWidth { get; set; } = 1.9;

    /// <summary>
    /// Fills the shape instead of stroking it, e.g. a saved bookmark.
    /// </summary>
    [Parameter]
    public bool Filled { get; set; }

    private bool IsFilled => Filled || Name is "more" or "play";
}
